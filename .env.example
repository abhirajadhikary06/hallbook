# Environment Configuration Example
# Copy this file to .env and update with your values

# Database Configuration
# For SQLite (default):
# DATABASE_URL=

# For PostgreSQL (production):
# DATABASE_URL=postgresql://username:password@host:port/database_name
# Example: DATABASE_URL=postgresql://hallbook:hallbook_password@postgres:5432/hallbook_db

# Security
COOKIE_SECRET=change-this-secret-in-production-make-it-at-least-32-chars

# PostgreSQL Password (if using PostgreSQL)
POSTGRES_PASSWORD=hallbook_password

# Application Settings
PORT=8888
DEBUG=0

# Optional: Add any other environment variables here
